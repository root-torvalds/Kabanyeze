[libraries]
linux.debug.x86_64 = "res://bin/libkabanyeze.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libkabanyeze.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://bin/libkabanyeze.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libkabanyeze.windows.template_release.x86_64.dll"
